.build/
build/
.DS_Store
*.xcodeproj
.swiftpm/
# Local tooling state: throwaway worktrees and machine-specific settings.
# A shared .claude/settings.json stays committable.
.claude/worktrees/
.claude/settings.local.json
# Working notes, kept out of the published repository
CLAUDE.md
ROADMAP.md

# Vendored SDKs are not redistributable. Ignore everything a vendor drop puts
# under vendor/<sdk>/ and keep only our own instructions: naming the individual
# folders missed the licence PDFs, sample code and release notes that ship
# alongside them, and relied on the case-insensitive default of a Mac volume to
# match an archive whose folders are capitalised.
vendor/*/*
!vendor/*/README.md
