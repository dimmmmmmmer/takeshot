<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- The app loads frameworks signed by other teams at runtime: Blackmagic's
         DeckLinkAPI and BlackmagicRawAPI, libsrt for the SRT output, and
         Vizrt's libndi for the NDI one. The hardened
         runtime's library validation refuses those without this entitlement;
         notarization allows it, and every pro-video app shipping vendor SDKs
         carries it. -->
    <key>com.apple.security.cs.disable-library-validation</key>
    <true/>
    <!-- The app opens a CoreAudio INPUT device: the audio-device picker in
         Settings, and the external-audio path that takes sound from a USB
         interface rather than off the SDI embed (AudioInputDevices,
         CapturePipeline+ExternalAudio). Under the hardened runtime that needs
         this key; Info.plist already carries NSMicrophoneUsageDescription for
         the TCC prompt, and without the entitlement the prompt never comes —
         the device simply returns nothing, on the one path a sound recordist
         hands the cart. Latent until the first Developer ID build, which is
         exactly when nobody is looking for it. -->
    <key>com.apple.security.device.audio-input</key>
    <true/>
</dict>
</plist>
