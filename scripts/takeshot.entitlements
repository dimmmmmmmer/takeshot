<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- The app loads frameworks signed by other teams at runtime: Blackmagic's
         DeckLinkAPI and BlackmagicRawAPI, and whatever a network output loads
         next. The hardened
         runtime's library validation refuses those without this entitlement;
         notarization allows it, and every pro-video app shipping vendor SDKs
         carries it. -->
    <key>com.apple.security.cs.disable-library-validation</key>
    <true/>
</dict>
</plist>
